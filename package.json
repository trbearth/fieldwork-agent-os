{
  "name": "fieldwork-agent-os",
  "version": "0.1.0",
  "description": "A local-first desktop workspace for configurable research agents and cited reports.",
  "private": false,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop": "npm run build && electron .",
    "desktop:open": "electron .",
    "desktop:package": "npm run build && electron-builder --projectDir desktop --mac dir",
    "agent": "node agents/run-all.mjs",
    "agent:signals": "node agent/run.mjs",
    "agent:fashion": "node agent/run.mjs",
    "agent:social": "node agents/social-pulse/run.mjs",
    "agent:batch": "node agents/batch-scout/run.mjs",
    "agents": "node agents/run-all.mjs",
    "agents:fixture": "node agents/run-all.mjs --fixture",
    "agent:fixture": "node agent/run.mjs --fixture",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-desktop --ignore-pattern .next",
    "doctor": "node scripts/doctor.mjs",
    "icon:build": "node scripts/create-icon.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
